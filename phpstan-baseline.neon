parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_callable\(\) with array\{WooCommerce, ''initialize_session''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Call to function method_exists\(\) with ''\\\\WPLC\\\\Billing…'' and ''can_renew'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Call to function method_exists\(\) with ''\\\\WPLC\\\\License…'' and ''deactivate'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Call to function method_exists\(\) with ''\\\\WPLC\\\\Update…'' and ''render_button'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Property WooCommerce\:\:\$session \(WC_Session\) in empty\(\) is not falsy\.$#'
			identifier: empty.property
			count: 2
			path: src/Account/CustomerPortal.php

		-
			message: '#^Result of \|\| is always false\.$#'
			identifier: booleanOr.alwaysFalse
			count: 1
			path: src/Account/CustomerPortal.php

		-
			message: '#^Call to function is_array\(\) with array\<string\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/AdminNotices.php

		-
			message: '#^Parameter \#2 \$value of method WC_Data\:\:update_meta_data\(\) expects array\|string, int\<1, 1000\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Admin/CatalogCsv.php

		-
			message: '#^Property WP_Screen\:\:\$post_type \(string\) in isset\(\) is not nullable\.$#'
			identifier: isset.property
			count: 1
			path: src/Admin/KeyConfigurationNotice.php

		-
			message: '#^Call to function method_exists\(\) with ''WPLC\\\\License\\\\LicenseLifecycle'' and ''admin_extend'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/LicenseAdmin.php

		-
			message: '#^Call to function method_exists\(\) with ''\\\\WPLC\\\\License…'' and ''deactivate'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/LicenseAdmin.php

		-
			message: '#^Call to function is_callable\(\) with array\{WC_Order\|WC_Order_Refund, ''get_status''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/LicenseDetail.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/LicenseListTable.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/Settings.php

		-
			message: '#^Strict comparison using \!\=\= between '''' and '''' will always evaluate to false\.$#'
			identifier: notIdentical.alwaysFalse
			count: 2
			path: src/Api/V1/ActivationService.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Api/V1/ClientIp.php

		-
			message: '#^Comparison operation "\>" between int\<1, 65535\> and 65535 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: src/Api/V1/SiteUrl.php

		-
			message: '#^Cannot cast WC_Order to int\.$#'
			identifier: cast.int
			count: 1
			path: src/Api/V1/StripeWebhook.php

		-
			message: '#^Instanceof between WC_Order and WC_Order will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Billing/RecurringConsent.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 3
			path: src/Billing/RecurringConsent.php

		-
			message: '#^Call to an undefined method WC_Order_Item\:\:get_total\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Billing/RenewalOrder.php

		-
			message: '#^Parameter \#2 \$value of method WC_Data\:\:update_meta_data\(\) expects array\|string, int given\.$#'
			identifier: argument.type
			count: 2
			path: src/Billing/RenewalOrder.php

		-
			message: '#^Call to function is_callable\(\) with array\{WC_Product, ''get_regular_price''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Catalog/Catalog.php

		-
			message: '#^Call to function is_array\(\) with array\<string, array\<int, array\{key\: string, label\: string\}\>\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Catalog/EntitlementCatalog.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/Catalog/EntitlementCatalog.php

		-
			message: '#^Access to property \$ID on an unknown class WPLC\\Catalog\\WP_Post\.$#'
			identifier: class.notFound
			count: 1
			path: src/Catalog/ProductEditor.php

		-
			message: '#^Parameter \$variation of method WPLC\\Catalog\\ProductEditor\:\:render_variation_fields\(\) has invalid type WPLC\\Catalog\\WP_Post\.$#'
			identifier: class.notFound
			count: 1
			path: src/Catalog/ProductEditor.php

		-
			message: '#^Call to static method get_stripe_amount\(\) on an unknown class WC_Stripe_Helper\.$#'
			identifier: class.notFound
			count: 1
			path: src/Gateway/StripeRecurringAdapter.php

		-
			message: '#^Call to static method request\(\) on an unknown class WC_Stripe_API\.$#'
			identifier: class.notFound
			count: 1
			path: src/Gateway/StripeRecurringAdapter.php

		-
			message: '#^Instanceof between WC_Order and WC_Order will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 2
			path: src/Gateway/StripeRecurringAdapter.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Gateway/StripeRecurringAdapter.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: src/Infrastructure/Database/Schema.php

		-
			message: '#^Static method WPLC\\Infrastructure\\Database\\Schema\:\:step_10_autoload_schema_version\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Infrastructure/Database/Schema.php

		-
			message: '#^Static property WPLC\\Infrastructure\\Database\\Schema\:\:\$steps \(array\<string, array\{string, string\}\>\) does not accept default value of type array\{10\: array\{''WPLC\\\\Infrastructure\\\\Database\\\\Schema'', ''step_10_autoload…''\}\}\.$#'
			identifier: property.defaultValue
			count: 1
			path: src/Infrastructure/Database/Schema.php

		-
			message: '#^Call to an undefined method WC_Order_Item\:\:get_product_id\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/License/LicenseIssuer.php

		-
			message: '#^Call to an undefined method WC_Order_Item\:\:get_variation_id\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/License/LicenseIssuer.php

		-
			message: '#^Parameter \#2 \$item of static method WPLC\\License\\LicenseIssuer\:\:create_license\(\) expects WC_Order_Item_Product, WC_Order_Item given\.$#'
			identifier: argument.type
			count: 1
			path: src/License/LicenseIssuer.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/License/LicenseKey.php

		-
			message: '#^Call to function is_callable\(\) with array\{WC_Order\|WC_Order_Refund, ''get_meta''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/License/LicenseLifecycle.php

		-
			message: '#^Property WC_Email\:\:\$object \(bool\|object\) does not accept array\<string, mixed\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Notifications/Emails/LicenseEmail.php

		-
			message: '#^Call to function is_array\(\) with array\<string, WC_Email\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Notifications/Notifications.php

		-
			message: '#^Call to function is_object\(\) with WC_Emails will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Notifications/Notifications.php

		-
			message: '#^Parameter \#1 \$price of function wc_price expects float, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Notifications/Notifications.php

		-
			message: '#^Parameter \#1 \$array \(list\<int\<1, 365\>\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Notifications/ReminderSchedule.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/Plugin.php

		-
			message: '#^Call to function is_array\(\) with array will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 2
			path: src/Security/SecretCrypto.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Update/LocalPackageStorage.php

		-
			message: '#^Method WPLC\\Update\\PackageStream\:\:serve\(\) never returns void so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Update/PackageStream.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
