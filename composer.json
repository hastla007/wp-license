{
  "name": "wplc/wp-license-captain",
  "description": "WooCommerce license and update manager for WP product plugins.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "WPLC\\\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit.integration.xml"
  }
}