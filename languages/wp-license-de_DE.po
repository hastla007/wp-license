#: src/Admin/CatalogCsv.php:103
msgid "Imports are limited to 1,000 rows and 2 MB per file. Comma or semicolon separated files are accepted (a file saved by Excel works). Product and plan keys may only contain lowercase letters, digits and hyphens. Validate the exported IDs/SKUs in a staging shop before importing."
msgstr "Importe sind auf 1.000 Zeilen und 2 MB pro Datei begrenzt. Durch Komma oder Semikolon getrennte Dateien werden akzeptiert (eine mit Excel gespeicherte Datei funktioniert). Produkt- und Tarifschlüssel dürfen nur Kleinbuchstaben, Ziffern und Bindestriche enthalten. Prüfe die exportierten IDs/Artikelnummern in einem Staging-Shop, bevor du sie importierst."

#. translators: %d: line number in the CSV file.
#: src/Admin/CatalogCsv.php:130
#, php-format
msgid "The import ran out of time and stopped before line %d. Everything before that line is saved. Import the same file again to finish; rows that are already imported are simply updated."
msgstr "Beim Import wurde die Zeit überschritten; er wurde vor Zeile %d beendet. Alles vor dieser Zeile ist gespeichert. Importiere dieselbe Datei erneut, um ihn abzuschließen; bereits importierte Zeilen werden einfach aktualisiert."

#: src/Admin/CatalogCsv.php:135
msgid "Line"
msgstr "Zeile"

#: src/Admin/CatalogCsv.php:513
msgid "The file could not be uploaded or read."
msgstr "Die Datei konnte nicht hochgeladen oder gelesen werden."

#: src/Admin/CatalogCsv.php:515
msgid "The file is larger than 2 MB."
msgstr "Die Datei ist größer als 2 MB."

#: src/Admin/CatalogCsv.php:517
msgid "The first line does not contain the expected column names. Export a file first and keep its header line unchanged."
msgstr "Die erste Zeile enthält nicht die erwarteten Spaltennamen. Exportiere zuerst eine Datei und lass deren Kopfzeile unverändert."

#: src/Admin/CatalogCsv.php:519
msgid "The file has more than 1,000 rows. The remaining rows were not imported."
msgstr "Die Datei hat mehr als 1.000 Zeilen. Die übrigen Zeilen wurden nicht importiert."

#: src/Admin/CatalogCsv.php:521
msgid "The line does not have nine columns."
msgstr "Die Zeile hat nicht neun Spalten."

#: src/Admin/CatalogCsv.php:523
msgid "The SKU does not match the SKU of this product in the shop."
msgstr "Die Artikelnummer (SKU) stimmt nicht mit der Artikelnummer dieses Produkts im Shop überein."

#: src/Admin/CatalogCsv.php:525
msgid "The variation ID is not a variation of the product ID."
msgstr "Die Varianten-ID ist keine Variante der Produkt-ID."

#: src/Admin/CatalogCsv.php:527
msgid "The product ID is a variation. Put the parent product in product_id and the variation in variation_id."
msgstr "Die Produkt-ID ist eine Variante. Trage das übergeordnete Produkt in product_id und die Variante in variation_id ein."

#: src/Admin/CatalogCsv.php:529
msgid "The support level must be community, standard or priority."
msgstr "Die Support-Stufe muss community, standard oder priority sein."

#: src/Admin/CatalogCsv.php:531
msgid "The live site limit must be a whole number from 1 to 1000."
msgstr "Das Limit für Live-Websites muss eine ganze Zahl von 1 bis 1000 sein."

#: src/Admin/CatalogCsv.php:533
msgid "The entitlements must be a JSON object with simple values (text, numbers, true/false) and at most 4096 characters."
msgstr "Die Berechtigungen müssen ein JSON-Objekt mit einfachen Werten (Text, Zahlen, true/false) und höchstens 4096 Zeichen sein."

#: src/Admin/CatalogCsv.php:535
msgid "The product is being edited by another user right now. Close the product editor and import the row again."
msgstr "Das Produkt wird gerade von einem anderen Benutzer bearbeitet. Schließe den Produkteditor und importiere die Zeile erneut."

