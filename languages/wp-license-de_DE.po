#, php-format
msgid "No test email was sent: you sent %s test emails within the last hour. Try again later."
msgstr "Keine Test-E-Mail gesendet: Du hast in der letzten Stunde %s Test-E-Mails gesendet. Versuche es später noch einmal."

#: src/Admin/SettingsTools.php:361
msgid "WordPress could not hand the test email over for sending. Check the email setup of this site."
msgstr "WordPress konnte die Test-E-Mail nicht zum Versand übergeben. Prüfe die E-Mail-Einrichtung dieser Website."

#. translators: 1: title of the email, 2: email address, 3: language code.
#: src/Admin/SettingsTools.php:367
#, php-format
msgid "The test email \"%1$s\" was handed over for sending to %2$s (language: %3$s). It contains sample data only."
msgstr "Die Test-E-Mail „%1$s“ wurde zum Versand an %2$s übergeben (Sprache: %3$s). Sie enthält nur Beispieldaten."

#: src/Admin/SettingsTools.php:602
msgid "Send a test email"
msgstr "Test-E-Mail senden"

