msgstr "Nicht gespeichert, weil der Wert nicht gültig ist: %s. Prüfe die Zahlen und antworte noch einmal."

#: src/Admin/SettingsTools.php:248
msgid "Your answers were saved."
msgstr "Deine Antworten wurden gespeichert."

#. translators: %s: list of setting names.
#: src/Admin/SettingsTools.php:252
#, php-format
