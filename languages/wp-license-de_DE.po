#. translators: %s: error code of the license server.
#: src/Client/Messages.php:175
#, php-format
msgid "The license server answered with the error \"%s\"."
msgstr "Der Lizenzserver hat mit dem Fehler „%s“ geantwortet."

#: src/Client/Messages.php:176
msgid "The license settings of this plugin are incomplete (server address, product key or signature key)."
msgstr "Die Lizenzeinstellungen dieses Plugins sind unvollständig (Serveradresse, Produktschlüssel oder Signaturschlüssel)."

#: src/Client/Messages.php:177
msgid "Please enter your license key."
msgstr "Bitte gib deinen Lizenzschlüssel ein."

#: src/Client/Messages.php:178
msgid "This site has not been activated with a license key yet."
msgstr "Diese Website wurde noch nicht mit einem Lizenzschlüssel aktiviert."

#: src/Client/Messages.php:179
msgid "The address of this site differs from the address the license was activated for. This looks like a copy of the site. Activate the license for this address."
msgstr "Die Adresse dieser Website weicht von der Adresse ab, für die die Lizenz aktiviert wurde. Das sieht nach einer Kopie der Website aus. Aktiviere die Lizenz für diese Adresse."

#: src/Client/Messages.php:180
msgid "The activation data could not be stored in the database of this site. Check the database and try again."
msgstr "Die Aktivierungsdaten konnten nicht in der Datenbank dieser Website gespeichert werden. Prüfe die Datenbank und versuche es erneut."

#: src/Client/Messages.php:181
msgid "The answer of the license server could not be stored in the database of this site. Check the database; the check is repeated automatically."
msgstr "Die Antwort des Lizenzservers konnte nicht in der Datenbank dieser Website gespeichert werden. Prüfe die Datenbank; die Prüfung wird automatisch wiederholt."

#: src/Client/Messages.php:182
msgid "The license data could not be removed from the database of this site. Check the database and try again."
msgstr "Die Lizenzdaten konnten nicht aus der Datenbank dieser Website entfernt werden. Prüfe die Datenbank und versuche es erneut."

#: src/Client/Messages.php:183
msgid "The request to the license server could not be prepared."
msgstr "Die Anfrage an den Lizenzserver konnte nicht vorbereitet werden."

#: src/Client/Messages.php:184
msgid "The license server answered with an unexpected error."
msgstr "Der Lizenzserver hat mit einem unerwarteten Fehler geantwortet."

#: src/Client/Messages.php:185
msgid "The license server could not be reached. Premium features keep working; the check is repeated automatically."
msgstr "Der Lizenzserver ist nicht erreichbar. Die Premiumfunktionen arbeiten weiter; die Prüfung wird automatisch wiederholt."

#: src/Client/Messages.php:186
msgid "The request was answered by a firewall or security service instead of the license server. Please ask your host to allow outgoing requests to the license server."
msgstr "Statt des Lizenzservers hat eine Firewall oder ein Sicherheitsdienst geantwortet. Bitte deinen Hoster, ausgehende Anfragen an den Lizenzserver zu erlauben."

#: src/Client/Messages.php:187
msgid "The license server sent an answer this plugin cannot read."
msgstr "Der Lizenzserver hat eine Antwort gesendet, die dieses Plugin nicht lesen kann."

#: src/Client/Messages.php:188
msgid "The answer of the license server could not be verified and was ignored."
msgstr "Die Antwort des Lizenzservers konnte nicht geprüft werden und wurde ignoriert."

#: src/Client/Messages.php:189
msgid "The answer does not carry a valid signature of the license server and was ignored. Updating this plugin may solve this."
msgstr "Die Antwort trägt keine gültige Signatur des Lizenzservers und wurde ignoriert. Ein Update dieses Plugins kann das beheben."

#: src/Client/Messages.php:190
msgid "The answer of the license server does not belong to this request and was ignored."
msgstr "Die Antwort des Lizenzservers gehört nicht zu dieser Anfrage und wurde ignoriert."

#: src/Client/Messages.php:191
msgid "The answer of the license server is for another product and was ignored."
msgstr "Die Antwort des Lizenzservers gilt für ein anderes Produkt und wurde ignoriert."

#: src/Client/Messages.php:192
msgid "The answer of the license server is older than one already received and was ignored."
msgstr "Die Antwort des Lizenzservers ist älter als eine bereits erhaltene und wurde ignoriert."

#: src/Client/Messages.php:193
msgid "This web server cannot check the signature of the license server (the PHP sodium functions are missing). Premium features stay off until PHP provides them."
msgstr "Dieser Webserver kann die Signatur des Lizenzservers nicht prüfen (die PHP-Funktionen von sodium fehlen). Die Premium-Funktionen bleiben ausgeschaltet, bis PHP sie bereitstellt."

#: src/Client/Messages.php:199
msgid "The activation request was rejected as incomplete. Check the license key."
msgstr "Die Aktivierungsanfrage wurde als unvollständig abgelehnt. Prüfe den Lizenzschlüssel."

#: src/Client/Messages.php:200
msgid "This license key is unknown. Please check it for typing errors."
msgstr "Dieser Lizenzschlüssel ist unbekannt. Bitte prüfe ihn auf Tippfehler."

#: src/Client/Messages.php:201
msgid "This license key belongs to another product."
msgstr "Dieser Lizenzschlüssel gehört zu einem anderen Produkt."

#: src/Client/Messages.php:202
msgid "This license has expired. Renew it to activate this site."
msgstr "Diese Lizenz ist abgelaufen. Verlängere sie, um diese Website zu aktivieren."

#: src/Client/Messages.php:203
msgid "This license is suspended. Please contact support."
msgstr "Diese Lizenz ist gesperrt. Bitte wende dich an den Support."

#: src/Client/Messages.php:204
msgid "This license has been revoked."
msgstr "Diese Lizenz wurde widerrufen."

#: src/Client/Messages.php:205
msgid "This license is not active."
msgstr "Diese Lizenz ist nicht aktiv."

#: src/Client/Messages.php:206
msgid "The license of this activation no longer exists on the license server."
msgstr "Die Lizenz dieser Aktivierung existiert auf dem Lizenzserver nicht mehr."

#: src/Client/Messages.php:207
msgid "All sites of this license are in use. Release a site in your customer account or upgrade the license."
msgstr "Alle Websites dieser Lizenz sind belegt. Gib in deinem Kundenkonto eine Website frei oder erweitere die Lizenz."

#: src/Client/Messages.php:208
msgid "The live site already has a staging site. Release it in your customer account first."
msgstr "Die Live-Website hat bereits eine Staging-Website. Gib diese zuerst in deinem Kundenkonto frei."

#: src/Client/Messages.php:209
msgid "Too many development sites are activated for this license. Release unused ones in your customer account."
msgstr "Für diese Lizenz sind zu viele Entwicklungs-Websites aktiviert. Gib nicht mehr benötigte in deinem Kundenkonto frei."

#: src/Client/Messages.php:210
msgid "A development activation is only possible on a local address (localhost, *.test, *.local)."
msgstr "Eine Entwicklungsaktivierung ist nur unter einer lokalen Adresse möglich (localhost, *.test, *.local)."

#: src/Client/Messages.php:211
msgid "A staging site must be linked to an activated live site of the same license."
msgstr "Eine Staging-Website muss mit einer aktivierten Live-Website derselben Lizenz verknüpft sein."

#: src/Client/Messages.php:212
msgid "The live site this staging site belongs to is not activated for this license."
msgstr "Die Live-Website, zu der diese Staging-Website gehört, ist für diese Lizenz nicht aktiviert."

#: src/Client/Messages.php:213
msgid "A staging activation cannot move to an address that is unrelated to its live site."
msgstr "Eine Staging-Aktivierung kann nicht auf eine Adresse umziehen, die nichts mit ihrer Live-Website zu tun hat."

#: src/Client/Messages.php:214
msgid "The activation data of this site does not match the license server. Please activate again."
msgstr "Die Aktivierungsdaten dieser Website passen nicht zum Lizenzserver. Bitte aktiviere erneut."

#: src/Client/Messages.php:215
msgid "The activation was interrupted by a parallel request. Please try again."
msgstr "Die Aktivierung wurde durch eine gleichzeitige Anfrage unterbrochen. Bitte versuche es erneut."

#: src/Client/Messages.php:216
msgid "The activation of this site was released. Enter the license key to activate it again."
msgstr "Die Aktivierung dieser Website wurde freigegeben. Gib den Lizenzschlüssel ein, um sie erneut zu aktivieren."

#: src/Client/Messages.php:217
msgid "The license server does not know the activation of this site. Enter the license key to activate it again."
msgstr "Der Lizenzserver kennt die Aktivierung dieser Website nicht. Gib den Lizenzschlüssel ein, um sie erneut zu aktivieren."

#: src/Client/Messages.php:218
msgid "The license server cannot read the activation of this site. Enter the license key to activate it again."
msgstr "Der Lizenzserver kann die Aktivierung dieser Website nicht lesen. Gib den Lizenzschlüssel ein, um sie erneut zu aktivieren."

#: src/Client/Messages.php:219
msgid "The stored activation does not belong to this installation."
msgstr "Die gespeicherte Aktivierung gehört nicht zu dieser Installation."

#: src/Client/Messages.php:220
msgid "This site is not the one the license was activated for."
msgstr "Dies ist nicht die Website, für die die Lizenz aktiviert wurde."

#: src/Client/Messages.php:221
msgid "A live site activation cannot be moved to a staging, local or test address. Activate this copy as a staging site instead."
msgstr "Eine Aktivierung für eine Live-Website kann nicht auf eine Staging-, lokale oder Testadresse übertragen werden. Aktiviere diese Kopie stattdessen als Staging-Website."

#: src/Client/Messages.php:222
msgid "The license server rejected the signature of this site."
msgstr "Der Lizenzserver hat die Signatur dieser Website abgelehnt."

#: src/Client/Messages.php:223
msgid "The clock of this server differs too much from the clock of the license server."
msgstr "Die Uhr dieses Servers weicht zu stark von der Uhr des Lizenzservers ab."

#: src/Client/Messages.php:224
msgid "Too many requests. Please try again in a few minutes."
msgstr "Zu viele Anfragen. Bitte versuche es in ein paar Minuten erneut."

#: src/Client/Messages.php:225
msgid "The license is being changed right now. Please try again in a moment."
msgstr "Die Lizenz wird gerade geändert. Bitte versuche es gleich noch einmal."

#: src/Client/Messages.php:227
msgid "Not activated"
msgstr "Nicht aktiviert"

#: src/Client/Messages.php:229
msgid "Payment overdue (grace period)"
msgstr "Zahlung überfällig (Kulanzzeit)"

#: src/Client/Messages.php:233
msgid "Not active"
msgstr "Nicht aktiv"

#: src/Client/Messages.php:234
msgid "Released on the license server"
msgstr "Auf dem Lizenzserver freigegeben"

#: src/Client/Messages.php:236
msgid "Could not be verified for too long"
msgstr "Zu lange nicht geprüft"

#: src/Client/Messages.php:238
msgid "The clock of this site is ahead, or the offline period has expired."
msgstr "Die Uhr dieser Website geht vor, oder die Offline-Frist ist abgelaufen."

