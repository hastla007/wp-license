#, php-format
msgid "WP License Captain: Stripe declined the renewal payment (code %1$s, decline code %2$s, advice %3$s, outcome %4$s). Further automatic attempts: %5$s."
msgstr "WP License Captain: Stripe hat die Zahlung für die Verlängerung abgelehnt (Code %1$s, Ablehnungscode %2$s, Empfehlung %3$s, Ergebnis %4$s). Weitere automatische Versuche: %5$s."

#: src/Gateway/StripeRecurringAdapter.php:781
msgid "yes"
msgstr "ja"

#: src/Gateway/StripeRecurringAdapter.php:781
msgid "no"
msgstr "nein"

#: src/Gateway/StripeRecurringAdapter.php:995
msgid "The customer is paying this renewal order. The automatic charge waits."
msgstr "Der Kunde bezahlt diese Verlängerungsbestellung gerade. Die automatische Abbuchung wartet."

#: src/Gateway/StripeRecurringAdapter.php:1040
msgid "Stripe could not be asked about earlier payments for this renewal."
msgstr "Stripe konnte nicht nach früheren Zahlungen für diese Verlängerung gefragt werden."

#: src/Gateway/StripeRecurringAdapter.php:1089
msgid "Stripe holds a payment for this renewal whose amount differs from the order."
msgstr "Stripe liegt eine Zahlung für diese Verlängerung vor, deren Betrag von der Bestellung abweicht."

#. translators: %s: Stripe payment method type, e.g. link.
#: src/Gateway/StripeRecurringAdapter.php:1312
#, php-format
msgid "WP License Captain: automatic renewal was requested, but the payment method of this order (%s) is not a saved card. The license will not renew automatically."
msgstr "WP License Captain: Die automatische Verlängerung wurde gewünscht, die Zahlungsart dieser Bestellung (%s) ist jedoch keine gespeicherte Karte. Die Lizenz verlängert sich nicht automatisch."

#: src/Gateway/StripeRecurringAdapter.php:1326
msgid "You asked for automatic renewal, but the payment method you used cannot be charged automatically. Your license runs until the end of the paid period. We will remind you before it ends so you can renew it yourself; to renew automatically, add a card in your account."
msgstr "Sie haben die automatische Verlängerung gewünscht, die verwendete Zahlungsart kann jedoch nicht automatisch belastet werden. Ihre Lizenz läuft bis zum Ende des bezahlten Zeitraums. Wir erinnern Sie vor dem Ablauf, damit Sie sie selbst verlängern können; für eine automatische Verlängerung hinterlegen Sie eine Karte in Ihrem Konto."

#: src/Gateway/StripeRecurringAdapter.php:1456
msgid "WP License Captain: future automatic renewals of this license use the card this order was paid with."
msgstr "WP License Captain: Künftige automatische Verlängerungen dieser Lizenz verwenden die Karte, mit der diese Bestellung bezahlt wurde."

#. translators: 1: installed database schema version, 2: schema version this plugin version supports.
#: src/Infrastructure/Database/Schema.php:491
#, php-format
msgid "WP License Captain: the database was upgraded by a newer plugin version (schema %1$s, this version supports %2$s). Renewal charges and customer emails are paused. Install the newer plugin version again."
msgstr "WP License Captain: Die Datenbank wurde von einer neueren Plugin-Version aktualisiert (Schema %1$s, diese Version unterstützt %2$s). Abbuchungen von Verlängerungen und E-Mails an Kunden sind pausiert. Installieren Sie die neuere Plugin-Version erneut."

#. translators: %s: technical error details.
#: src/Infrastructure/Database/Schema.php:515
#, php-format
msgid "WP License Captain could not update its database tables. The plugin keeps working with the previous structure and retries automatically. Details: %s"
msgstr "WP License Captain konnte seine Datenbanktabellen nicht aktualisieren. Das Plugin arbeitet mit der bisherigen Struktur weiter und versucht es automatisch erneut. Details: %s"

