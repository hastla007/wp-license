msgstr "Jetzt auf %1$s upgraden: %2$s für den Rest des bezahlten Zeitraums bis %3$s (die Steuern werden auf der Zahlungsseite berechnet). Danach %4$s %5$s."

#. translators: 1: new renewal amount, 2: "per year" or "per month", 3: date of the next automatic charge.
#: src/Billing/PlanUpgrade.php:695
#, php-format
msgid "I agree that my saved payment method is charged %1$s %2$s automatically from the next renewal on %3$s, until I cancel."
msgstr "Ich bin damit einverstanden, dass meine gespeicherte Zahlungsart ab der nächsten Verlängerung am %3$s automatisch mit %1$s %2$s belastet wird, bis ich kündige."

#. translators: %s: plan name.
#: src/Billing/PlanUpgrade.php:699
#, php-format
msgid "Upgrade to %s"
msgstr "Auf %s upgraden"

#. translators: 1: plan name, 2: regular price, 3: "per year" or "per month".
