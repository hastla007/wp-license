#: src/Billing/PlanUpgrade.php:404
#, php-format
msgid "WP License Captain switched license #%1$d to plan %2$s."
msgstr "WP License Captain hat Lizenz #%1$d auf den Tarif %2$s umgestellt."

#. translators: 1: renewal amount, 2: time of the consent (UTC).
#: src/Billing/PlanUpgrade.php:409
#, php-format
msgid "The customer agreed to automatic renewals of %1$s from the next period (%2$s UTC)."
msgstr "Der Kunde hat automatischen Verlängerungen über %1$s ab dem nächsten Zeitraum zugestimmt (%2$s UTC)."

#: src/Billing/PlanUpgrade.php:465
msgid "WP License Captain: this plan upgrade payment could not be applied to the license. Refund the order or change the plan on the license page."
msgstr "WP License Captain: Diese Zahlung für das Tarif-Upgrade konnte nicht auf die Lizenz angewendet werden. Erstatten Sie die Bestellung oder ändern Sie den Tarif auf der Lizenzseite."

#: src/Billing/PlanUpgrade.php:575
msgid "WP License Captain: the plan upgrade was refunded; the license is back on its previous plan."
msgstr "WP License Captain: Das Tarif-Upgrade wurde erstattet; die Lizenz hat wieder ihren vorherigen Tarif."

#: src/Billing/PlanUpgrade.php:576
msgid "WP License Captain: the plan upgrade was refunded; the license plan was not changed (the upgraded period has ended, the plan changed since, or the upgrade was never applied). Change the plan on the license page if needed."
msgstr "WP License Captain: Das Tarif-Upgrade wurde erstattet; der Tarif der Lizenz wurde nicht geändert (der Upgrade-Zeitraum ist beendet, der Tarif wurde seitdem geändert oder das Upgrade wurde nie angewendet). Ändern Sie den Tarif bei Bedarf auf der Lizenzseite."

#: src/Billing/PlanUpgrade.php:610
msgid "Partial refund: the license keeps its upgraded plan. Change the plan on the license page if the refund should undo the upgrade."
msgstr "Teilerstattung: Die Lizenz behält ihren höheren Tarif. Ändern Sie den Tarif auf der Lizenzseite, wenn die Erstattung das Upgrade rückgängig machen soll."

#: src/Billing/PlanUpgrade.php:649
