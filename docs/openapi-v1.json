{
  "openapi": "3.0.3",
  "info": {
    "title": "WP License Captain REST API",
    "version": "1.0.0",
    "description": "Versioned v1 contract for license activation, entitlement checks, Stripe webhook receipt, premium updates and the public response signing keys."
  },
  "servers": [
    {
      "url": "https://license.example/wp-json/wplc/v1"
    }
  ],
  "tags": [
    {
      "name": "Activations"
    },
    {
      "name": "Entitlements"
    },
    {
      "name": "Updates"
    },
    {
      "name": "Webhooks"
    },
    {
      "name": "Signing keys"
    }
  ],
  "paths": {
    "/activations": {
      "post": {
        "tags": [
          "Activations"
        ],
        "summary": "Activate a product installation",
        "operationId": "createActivation",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activation created or idempotently retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/activations/{activation_id}": {
      "delete": {
        "tags": [
          "Activations"
        ],
        "summary": "Deactivate the authenticated installation",
        "operationId": "deleteActivation",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "parameters": [
          {
            "name": "activation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activation was deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/entitlements/check": {
      "post": {
        "tags": [
          "Entitlements"
        ],
        "summary": "Get current license status and feature rights",
        "operationId": "checkEntitlements",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientVersionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed current entitlement snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/updates/check": {
      "post": {
        "tags": [
          "Updates"
        ],
        "summary": "Check for an authorized premium update",
        "operationId": "checkUpdate",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed update metadata or signed no-update result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/updates/download/{token}": {
      "get": {
        "tags": [
          "Updates"
        ],
        "summary": "Consume a short-lived, one-use update grant",
        "operationId": "downloadUpdate",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to an allow-listed HTTPS package URL.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Grant is invalid, expired, consumed, or no longer entitled."
          }
        }
      }
    },
    "/signing-keys": {
      "get": {
        "tags": [
          "Signing keys"
        ],
        "summary": "Public Ed25519 response signing keys (current and, during a rotation, next)",
        "operationId": "listSigningKeys",
        "security": [],
        "responses": {
          "200": {
            "description": "Public keys and key ids; never creates a key. Release pipelines compare the keys pinned in product builds against this list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigningKeys"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/stripe": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Receive a signed Stripe PaymentIntent event",
        "operationId": "receiveStripeWebhook",
        "security": [
          {
            "StripeSignature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "data"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "object"
                    ],
                    "properties": {
                      "object": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event recorded, acknowledged as duplicate, or ignored."
          },
          "400": {
            "description": "Invalid signature, body, or required renewal metadata."
          },
          "500": {
            "description": "Event could not be recorded."
          },
          "503": {
            "description": "Webhook verification is not configured."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InstallationHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WPLC-Signature",
        "description": "Requires X-WPLC-Installation-Id, X-WPLC-Timestamp and X-WPLC-Nonce as well. Sign uppercase method, REST route, timestamp, nonce and SHA-256 of raw body, newline-separated, with the installation secret using HMAC-SHA-256."
      },
      "StripeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature"
      }
    },
    "schemas": {
      "ActivationRequest": {
        "type": "object",
        "required": [
          "license_key",
          "product_key",
          "installation_id",
          "installation_secret",
          "site_url"
        ],
        "properties": {
          "license_key": {
            "type": "string",
            "minLength": 1
          },
          "product_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_secret": {
            "type": "string",
            "minLength": 32,
            "maxLength": 128,
            "writeOnly": true
          },
          "site_url": {
            "type": "string",
            "format": "uri"
          },
          "environment": {
            "type": "string",
            "enum": [
              "production",
              "staging",
              "development"
            ],
            "default": "production"
          },
          "staging_parent_installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_version": {
            "type": "string"
          },
          "wp_version": {
            "type": "string"
          },
          "php_version": {
            "type": "string"
          }
        }
      },
      "ClientVersionRequest": {
        "type": "object",
        "properties": {
          "product_version": {
            "type": "string"
          },
          "wp_version": {
            "type": "string"
          },
          "php_version": {
            "type": "string"
          },
          "site_url": {
            "type": "string",
            "format": "uri",
            "description": "Current home URL of the installation. When present it must name the activation's site (scheme and a leading www. are ignored), otherwise 409 site_mismatch."
          }
        }
      },
      "UpdateCheckRequest": {
        "type": "object",
        "required": [
          "product_key",
          "current_version"
        ],
        "properties": {
          "product_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "current_version": {
            "type": "string"
          },
          "site_url": {
            "type": "string",
            "format": "uri",
            "description": "Current home URL of the installation. When present it must name the activation's site (scheme and a leading www. are ignored), otherwise 409 site_mismatch."
          }
        }
      },
      "SignedEnvelope": {
        "type": "object",
        "required": [
          "data",
          "signature"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Response-specific payload. Entitlement responses include activation_id, installation_id, license_status, paid_until, site_limit, site_count, environment, entitlements, server_time and cache_expires_at."
          },
          "signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "HMAC-SHA-256 over JSON_UNESCAPED_SLASHES encoding of data using the installation secret."
          },
          "signature_ed25519": {
            "type": "string",
            "description": "Base64 Ed25519 signature of \"wplc-response-v1\\n{installation UUID}\\n{JSON of data}\" with the server key (docs/API-V1.md)."
          },
          "key_id": {
            "type": "string",
            "description": "First 16 hex characters of SHA-256 of the Ed25519 public key of signature_ed25519 (the current key)."
          },
          "signatures": {
            "type": "array",
            "description": "Only while a next signing key is configured (key rotation): the Ed25519 signature of every server key over the same message, current key first. signature_ed25519/key_id stay those of the current key.",
            "items": {
              "$ref": "#/components/schemas/KeySignature"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              }
            }
          }
        }
      },
      "KeySignature": {
        "type": "object",
        "required": [
          "key_id",
          "signature_ed25519"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "signature_ed25519": {
            "type": "string",
            "description": "Base64 Ed25519 signature."
          }
        }
      },
      "SigningKeys": {
        "type": "object",
        "required": [
          "context",
          "current",
          "next"
        ],
        "properties": {
          "context": {
            "type": "string",
            "enum": [
              "wplc-response-v1"
            ]
          },
          "current": {
            "type": "object",
            "nullable": true,
            "required": [
              "public_key",
              "key_id"
            ],
            "properties": {
              "public_key": {
                "type": "string",
                "description": "Base64 Ed25519 public key (32 bytes)."
              },
              "key_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$",
                "description": "First 16 hex characters of SHA-256 of the public key."
              }
            },
            "description": "Key of signature_ed25519; null when the server has no key yet."
          },
          "next": {
            "type": "object",
            "nullable": true,
            "required": [
              "public_key",
              "key_id"
            ],
            "properties": {
              "public_key": {
                "type": "string",
                "description": "Base64 Ed25519 public key (32 bytes)."
              },
              "key_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$",
                "description": "First 16 hex characters of SHA-256 of the public key."
              }
            },
            "description": "Next key during a rotation, otherwise null."
          }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "WordPress REST API error response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
