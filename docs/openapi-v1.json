{
  "openapi": "3.0.3",
  "info": {
    "title": "WP License Captain REST API",
    "version": "1.0.0",
    "description": "Versioned v1 contract for license activation, entitlement checks, Stripe webhook receipt, and premium updates."
  },
  "servers": [
    {
      "url": "https://license.example/wp-json/wplc/v1"
    }
  ],
  "tags": [
    {
      "name": "Activations"
    },
    {
      "name": "Entitlements"
    },
    {
      "name": "Updates"
    },
    {
      "name": "Webhooks"
    }
  ],
  "paths": {
    "/activations": {
      "post": {
        "tags": [
          "Activations"
        ],
        "summary": "Activate a product installation",
        "operationId": "createActivation",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activation created or idempotently retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ApiError"
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/activations/{activation_id}": {
      "delete": {
        "tags": [
          "Activations"
        ],
        "summary": "Deactivate the authenticated installation",
        "operationId": "deleteActivation",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "parameters": [
          {
            "name": "activation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activation was deactivated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "409": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/entitlements/check": {
      "post": {
        "tags": [
          "Entitlements"
        ],
        "summary": "Get current license status and feature rights",
        "operationId": "checkEntitlements",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientVersionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed current entitlement snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "404": {
            "$ref": "#/components/responses/ApiError"
          },
          "429": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/updates/check": {
      "post": {
        "tags": [
          "Updates"
        ],
        "summary": "Check for an authorized premium update",
        "operationId": "checkUpdate",
        "security": [
          {
            "InstallationHmac": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed update metadata or signed no-update result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ApiError"
          },
          "403": {
            "$ref": "#/components/responses/ApiError"
          },
          "503": {
            "$ref": "#/components/responses/ApiError"
          }
        }
      }
    },
    "/updates/download/{token}": {
      "get": {
        "tags": [
          "Updates"
        ],
        "summary": "Consume a short-lived, one-use update grant",
        "operationId": "downloadUpdate",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to an allow-listed HTTPS package URL. Sent with Cache-Control: no-store and Referrer-Policy: no-referrer.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "404": {
            "description": "Grant is invalid, expired, consumed, or no longer entitled."
          }
        }
      }
    },
    "/webhooks/stripe": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Receive a signed Stripe PaymentIntent event",
        "operationId": "receiveStripeWebhook",
        "security": [
          {
            "StripeSignature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "data"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "object"
                    ],
                    "properties": {
                      "object": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event recorded, acknowledged as duplicate, or ignored."
          },
          "400": {
            "description": "Invalid signature, body, or required renewal metadata."
          },
          "500": {
            "description": "Event could not be recorded."
          },
          "503": {
            "description": "Webhook verification is not configured."
          }
        }
      }
    },
    "/packages/{token}": {
      "get": {
        "tags": [
          "Updates"
        ],
        "summary": "Stream a locally stored release package for a short-lived, one-use token",
        "operationId": "streamPackage",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The package ZIP (application/zip). Sent with Cache-Control: no-store."
          },
          "404": {
            "description": "Unknown, expired or already used token."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InstallationHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-WPLC-Signature",
        "description": "Requires X-WPLC-Installation-Id, X-WPLC-Timestamp and X-WPLC-Nonce as well. Sign uppercase method, REST route, timestamp, nonce and SHA-256 of raw body, newline-separated, with the installation secret using HMAC-SHA-256."
      },
      "StripeSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "Stripe-Signature"
      }
    },
    "schemas": {
      "ActivationRequest": {
        "type": "object",
        "required": [
          "license_key",
          "product_key",
          "installation_id",
          "installation_secret",
          "site_url"
        ],
        "properties": {
          "license_key": {
            "type": "string",
            "minLength": 1
          },
          "product_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "installation_secret": {
            "type": "string",
            "minLength": 32,
            "maxLength": 128,
            "writeOnly": true
          },
          "site_url": {
            "type": "string",
            "format": "uri"
          },
          "environment": {
            "type": "string",
            "enum": [
              "production",
              "staging",
              "development"
            ],
            "default": "production"
          },
          "staging_parent_installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_version": {
            "type": "string"
          },
          "wp_version": {
            "type": "string"
          },
          "php_version": {
            "type": "string"
          }
        }
      },
      "ClientVersionRequest": {
        "type": "object",
        "properties": {
          "product_version": {
            "type": "string"
          },
          "wp_version": {
            "type": "string"
          },
          "php_version": {
            "type": "string"
          }
        }
      },
      "UpdateCheckRequest": {
        "type": "object",
        "required": [
          "product_key",
          "current_version"
        ],
        "properties": {
          "product_key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "current_version": {
            "type": "string"
          }
        }
      },
      "SignedEnvelope": {
        "type": "object",
        "required": [
          "data",
          "signature",
          "payload",
          "payload_signature"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Kept for clients that predate payload; current clients must read the data member of the verified payload instead. Response-specific payload. Entitlement responses include activation_id, installation_id, license_status, paid_until, site_limit, site_count, environment, entitlements, server_time and cache_expires_at."
          },
          "signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Legacy: HMAC-SHA-256 over JSON_UNESCAPED_SLASHES encoding of data using the installation secret. Verifiable only by re-encoding data identically; superseded by payload_signature."
          },
          "payload": {
            "type": "string",
            "description": "The exact JSON text that was signed: an object with the members data (same content as the data field) and nonce. nonce echoes the X-WPLC-Nonce header of an authenticated request; for POST /activations it is the installation_id of the request. Verify payload_signature over these bytes before decoding, then compare nonce with the value sent."
          },
          "payload_signature": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Lowercase hex HMAC-SHA-256 over the payload string as transmitted, keyed by the installation secret."
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ApiError": {
        "description": "WordPress REST API error response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
